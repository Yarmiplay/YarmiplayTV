<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Orbital Sync Loop (Back Arc) -->
    <path
        android:pathData="M85,38 A38,24 -24 0,0 23,70"
        android:strokeColor="#993DA5F4"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- Central Play Prism: Drop Shadow -->
    <path
        android:pathData="M31,21.5 L89,55.5 L31,89.5 Z"
        android:fillColor="#55000000" />

    <!-- Facet 2: Bottom Facet (Azure Shadow) -->
    <path
        android:pathData="M50,54 L89,54 L31,88 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="54"
                android:endX="31"
                android:endY="88"
                android:type="linear">
                <item android:color="#FF1E68B8" android:offset="0.0" />
                <item android:color="#FF0D2E55" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Facet 3: Spine Facet (Mid-tone Electric Blue) -->
    <path
        android:pathData="M31,20 L50,54 L31,88 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="20"
                android:endX="31"
                android:endY="88"
                android:type="linear">
                <item android:color="#FF54B4FF" android:offset="0.0" />
                <item android:color="#FF3DA5F4" android:offset="0.45" />
                <item android:color="#FF1A5FA8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Facet 1: Top Facet (Illuminated Sky Blue / White Highlight) -->
    <path
        android:pathData="M31,20 L89,54 L50,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="20"
                android:endX="89"
                android:endY="54"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FF99DEFF" android:offset="0.4" />
                <item android:color="#FF3DA5F4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Prism Fold Creases -->
    <path
        android:pathData="M50,54 L89,54"
        android:strokeColor="#EEFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31,20 L50,54"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.0"
        android:strokeLineCap="round" />
    <path
        android:pathData="M31,88 L50,54"
        android:strokeColor="#8870C4FF"
        android:strokeWidth="1.0"
        android:strokeLineCap="round" />

    <!-- Prism Outer Rim Highlight (Clean vertex, NO dot at tip) -->
    <path
        android:pathData="M31,20 L89,54 L31,88 Z"
        android:strokeColor="#CCFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round" />

    <!-- Orbital Sync Loop (Front Arc) -->
    <path
        android:pathData="M23,70 A38,24 -24 0,0 85,38"
        android:strokeWidth="3.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="23"
                android:startY="70"
                android:endX="85"
                android:endY="38"
                android:type="linear">
                <item android:color="#FF70C4FF" android:offset="0.0" />
                <item android:color="#FFFFFFFF" android:offset="0.75" />
                <item android:color="#FFA6E1FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Sync Node (Single bright satellite on front arc) -->
    <path
        android:pathData="M65,77 m-3.2,0 a3.2,3.2 0 1,1 6.4,0 a3.2,3.2 0 1,1 -6.4,0"
        android:fillColor="#FFFFFFFF" />
</vector>
